# Dev-mode backend URL (08.09 follow-up — proper dev/prod extension environments). Loaded by
# WXT's own per-mode env mechanism (wxt/dist/core/utils/env.mjs's loadEnv: `.env.${mode}`,
# confirmed against the installed wxt@0.19.29 source, not assumed) whenever mode is
# "development" — which `wxt` (the dev server, i.e. `npm run dev` / root `npm run dev:extension`)
# uses by default. Not a secret (a fixed localhost URL), so unlike backend/.env this is
# committed — same reasoning as backend/.env.example, just following Vite/WXT's own convention
# of committing .env.<mode> instead of a separate .example file. Read two ways: wxt.config.ts
# itself (Node context, process.env.WXT_BACKEND_URL — WXT's loadEnv populates process.env
# before this file's manifest() function is actually invoked) and lib/backend.ts (bundled
# runtime code, import.meta.env.WXT_BACKEND_URL — Vite substitutes this at build time; see
# env.d.ts for the ImportMetaEnv augmentation this requires). WXT_ prefix required — WXT's own
# envPrefix config only exposes WXT_*/VITE_* vars to import.meta.env.
WXT_BACKEND_URL=http://localhost:3000

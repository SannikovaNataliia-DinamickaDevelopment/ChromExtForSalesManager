# Secrets — never commit
.env
.env.*
!.env.example
# extension/.env.development and extension/.env.production (08.09 follow-up) hold WXT's own
# per-mode config (WXT_BACKEND_URL) — a fixed localhost URL and an as-yet-nonexistent placeholder,
# neither a secret. Committed deliberately, same "documented template, no real credentials"
# reasoning as !.env.example above, following Vite/WXT's own convention of committing .env.<mode>
# (only .env.*.local is meant to stay local/gitignored — not used by this project).
!extension/.env.development
!extension/.env.production
*.pem
*.key
service-account*.json
google-sa*.json

# Dependencies
node_modules/

# Build output
dist/
build/
.wxt/
extension/.output/

# Local Postgres data volume (if ever bind-mounted instead of a named Docker volume)
postgres-data/

# Phase 0 spike snapshots, not part of the shipped app
spikes/

# Editor/OS noise
.DS_Store
Thumbs.db

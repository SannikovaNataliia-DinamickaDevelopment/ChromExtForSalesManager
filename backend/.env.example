# Backend HTTP port
PORT=3000

# Postgres connection (matches backend/docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sales_manager

# Phase 1-4 stub owner: no auth yet, every lead is owned by this fixed user id.
# Must be a valid UUID; the backend upserts a matching row in `users` on boot.
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Chrome extension origin allowed by CORS, e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop
# Find it at chrome://extensions after loading the unpacked extension.
EXTENSION_ORIGIN=chrome-extension://REPLACE_WITH_EXTENSION_ID

# Google Sheets destination (service account, not interactive OAuth)
GOOGLE_SA_KEY_PATH=./secrets/service-account.json
SHEET_ID=REPLACE_WITH_SHEET_ID

# Sheets sync toggle (30.08 follow-up, per the 27.08 call — the dashboard has fully replaced the
# Sheet as how the team views leads). Defaults to disabled: leave unset (or anything other than
# "true") to keep it off. Set to "true" to turn Sheets sync back on — GOOGLE_SA_KEY_PATH/SHEET_ID
# above still need to be valid when you do; this toggle doesn't remove that requirement, it just
# skips the Sheets write entirely while off.
GOOGLE_SHEETS_SYNC_ENABLED=false

# Google OIDC login (phase 5) — from the Google Cloud Console OAuth client
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Signs backend session tokens + OIDC state. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Apollo.io provider for LPR ("DM") search — alternate to OpenAI/Gemini/Claude, a maintained
# lookup database rather than a generative model. Free developer account at developer.apollo.io.
# Note: only the mixed_people/api_search call (candidate discovery) is free — people/bulk_match
# (the actual name+linkedin_url lookup) consumes Apollo credits per person.
APOLLO_API_KEY=REPLACE_WITH_APOLLO_API_KEY

# OpenAI — production default provider for DM/LPR search (openai-classifier.service.ts:
# Structured Outputs + forced web_search calls). Also read by
# openai-industry-classifier.service.ts, but that path is currently dead: industry
# classification's LLM step was removed entirely (01.09 client decision — Apollo's raw industry
# field is used directly instead, see CLAUDE.md's decision log) — classifyIndustry() always
# returns INDUSTRY_CLASSIFY_DISABLED now regardless of this key. Leaving this note so nobody
# re-enables that path confused. platform.openai.com — no free tier, and this codebase has no
# spend cap or budget alerting configured anywhere for it.
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY

# Google Gemini — free-tier IT/not-IT classification (is_it, gemini-classifier.service.ts) and
# Gemini's own alternate DM/LPR search provider (?provider=gemini). Google AI Studio, free tier.
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY

# Separate Gemini key used only for the DM/LPR search manual-quality-test scope's grounded
# search — deliberately NOT shared with GEMINI_API_KEY above (see
# gemini-classifier.service.ts's own comment). Known history on this project: the grounded
# google_search tool call 429'd immediately on a shared key, evidence pointing to no billing
# being linked — optional, not part of the recommended default path; only needed if you're
# specifically re-testing Gemini's grounded DM search.
GEMINI_API_KEY_LPR_TEST=REPLACE_WITH_GEMINI_API_KEY_LPR_TEST

# Optional Gemini model override (gemini-classifier.service.ts / industry-classifier.service.ts)
# — falls back to a hardcoded default if unset. Leave blank/unset unless you have a specific
# reason to pin a different model.
GEMINI_MODEL=

# Anthropic Claude — alternate DM/LPR search provider, manual quality-test scope only
# (claude-classifier.service.ts). Optional. The one live test on record cost ~$0.65/lead
# (roughly 5-6x OpenAI's own DM search cost) — that's why it was never made a default. Don't
# enable this casually or at any real volume.
ANTHROPIC_API_KEY_LPR_TEST=REPLACE_WITH_ANTHROPIC_API_KEY_LPR_TEST
